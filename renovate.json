{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Asia/Tokyo",
  "prConcurrentLimit": 0,
  "platformAutomerge": false,
  "extends": [
    "config:best-practices",
    "config:js-app",
    ":automergeMinor",
    ":automergeLinters",
    ":automergeTesters",
    ":automergeTypes"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": ["security"],
    "schedule": ["at any time"]
  }
}
